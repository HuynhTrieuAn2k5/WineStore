@model Customer
@{ ViewData["Title"] = "Sửa khách hàng"; }

<div class="card" style="max-width: 600px; margin: 2rem auto;">
    <div class="card-header">
        <h2>Sửa thông tin khách hàng</h2>
    </div>
    <form asp-action="Edit" method="post" style="padding: 1.5rem;">
        <input type="hidden" asp-for="CustomerId" />
        
        <div class="form-group">
            <label asp-for="FullName">Họ tên *</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        
        <div class="form-group">
            <label asp-for="Cccd">CCCD *</label>
            <input asp-for="Cccd" class="form-control" />
            <span asp-validation-for="Cccd" class="text-danger"></span>
        </div>

        <div class="form-group" style="display: flex; gap: 1rem;">
            <div style="flex: 1;">
                <label asp-for="DateOfBirth">Ngày sinh *</label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>
            <div style="flex: 1;">
                <label asp-for="Gender">Giới tính</label>
                <select asp-for="Gender" class="form-control">
                    <option value="">-- Chọn --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>
        </div>

        <div class="form-group" style="display: flex; gap: 1rem;">
            <div style="flex: 1;">
                <label asp-for="Phone">Điện thoại</label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div style="flex: 1;">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Address">Địa chỉ</label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Occupation">Nghề nghiệp</label>
            <input asp-for="Occupation" class="form-control" />
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn-outline">Hủy</a>
        </div>
    </form>
</div>
