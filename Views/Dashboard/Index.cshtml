@{
    ViewData["Title"] = "Tổng quan";
    var stockWarnings = ViewBag.StockWarningProducts as IEnumerable<ChilliquerAspNetCore.Models.Entities.Product>;
}
<h1>Tổng quan</h1>
<div class="grid cards">
    <div class="card stat">
        <span>🍷 Sản phẩm</span>
        <strong>@ViewBag.ProductCount</strong>
    </div>
    <div class="card stat">
        <span>👥 Khách hàng</span>
        <strong>@ViewBag.CustomerCount</strong>
    </div>
    <div class="card stat">
        <span>📝 Hóa đơn</span>
        <strong>@ViewBag.InvoiceCount</strong>
    </div>
    <div class="card stat @(ViewBag.StockWarningCount > 0 ? "stat-warning" : "")">
        <span>⚠️ Cảnh báo tồn</span>
        <strong>@ViewBag.StockWarningCount</strong>
    </div>
    <div class="card stat">
        <span>💰 Doanh thu hôm nay</span>
        <strong>@String.Format("{0:N0} đ", ViewBag.TodayRevenue)</strong>
    </div>
</div>

@if (stockWarnings != null && stockWarnings.Any())
{
    <div class="card" style="margin-top: 24px;">
        <div class="card-header" style="flex-direction: row; justify-content: space-between; align-items: center;">
            <h2 style="margin: 0; color: var(--danger); font-size: 1.2rem;">⚠️ Sản phẩm cần nhập thêm</h2>
            <a asp-controller="Inventory" asp-action="StockWarning" style="font-weight: 700;">Xem tất cả →</a>
        </div>
        <table class="table" style="margin-top: 12px;">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Tồn kho</th>
                    <th>Tối thiểu</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in stockWarnings.Take(5))
                {
                    var statusClass = item.StockQuantity == 0 ? "severity-critical" : "severity-high";
                    var statusLabel = item.StockQuantity == 0 ? "Hết hàng" : "Sắp hết";
                    <tr>
                        <td>@item.ProductCode</td>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Category?.CategoryName</td>
                        <td><strong style="color: var(--danger);">@item.StockQuantity</strong></td>
                        <td>@item.MinStockAlert</td>
                        <td><span class="@statusClass" style="padding: 4px 10px; border-radius: 8px; font-size: 0.8rem; font-weight: 700;">@statusLabel</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
